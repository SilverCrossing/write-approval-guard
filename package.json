{
  "name": "write-approval-guard",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "SilverCrossing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverCrossing/write-approval-guard.git"
  },
  "type": "module",
  "description": "Approval for every write-type file operation, a second confirmation for destructive or system-level changes, and approval before reading secret-bearing configuration files.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "classify.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  }
}
